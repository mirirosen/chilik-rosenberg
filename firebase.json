{
  "hosting": {
    "public": "dist",
    "predeploy": [
      "node scripts/refuse-default-hosting-deploy.cjs"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
