# Build-time configuration of the LIVE booking hosting (hilik-site), recovered from the deployed bundle on 2026-10-24.
# These are public Firebase web-client values, not secrets: they ship inside every page.
# Before `npm run build:booking`, copy this file to the repo root as `.env.booking.local`
# (gitignored; Vite loads it for --mode booking). Without it the build silently disables booking,
# and the hosting predeploy check (scripts/assert-booking-hosting-build.cjs) refuses to deploy.
VITE_FIREBASE_EMULATORS=false
VITE_PAYMENT_API_BASE=https://us-central1-hilik-site.cloudfunctions.net
VITE_CALENDAR_AVAILABILITY_ENABLED=true
VITE_BOOKING_FIREBASE_PROJECT_ID=hilik-site
VITE_BOOKING_FIREBASE_API_KEY=AIzaSyCcuSCkpmwyHCjTBeYaZHc2DHHhKVBXwvo
VITE_BOOKING_FIREBASE_AUTH_DOMAIN=hilik-site.firebaseapp.com
VITE_BOOKING_FIREBASE_APP_ID=1:815275120808:web:a4d72be1ff1c27b3108a9d
# GA4 (docs/ANALYTICS.md). Empty = the built-in default G-165V7SRZJK. Another G-... ID overrides it;
# "off" removes analytics (no banner, no script). Either way gtag loads only after explicit consent.
VITE_GA4_MEASUREMENT_ID=
