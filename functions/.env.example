# Grow sandbox credentials — NEVER commit real values.
# Copy to functions/.env and fill from the Secure Vault at deploy time.
# Never paste these in chat / email / WhatsApp.

# --- Grow (card clearing) — SANDBOX ---
GROW_API_BASE=https://sandbox.meshulam.co.il
GROW_USER_ID=<sandbox userId from Grow>
GROW_PAGE_CODE=<sandbox redirect pageCode from Grow>
# Exact HTTPS URL of the deployed growWebhook function (set after deploy):
GROW_NOTIFY_URL=https://us-central1-<project-id>.cloudfunctions.net/growWebhook
# Public site origin used for successUrl/cancelUrl (must be HTTPS):
SITE_ORIGIN=https://<firebase-hosting-domain>

# --- Morning (auto-receipt, phase 2, optional) ---
# Miri's Morning account: yechielrozenberg@gmail.com ("y rozenberg") — invoices/receipts only.
MORNING_API_BASE=https://sandbox.d.greeninvoice.co.il/api/v1
MORNING_KEY_ID=<api key id from Morning dashboard>
MORNING_KEY_SECRET=<redacted>
