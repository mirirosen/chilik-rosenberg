# Manual rollout gates: undefined also means disabled. HTTP IAM is always private.
CHILIK_BOOKING_RUNTIME_ENABLED=false
CHILIK_BOOKING_SCHEDULERS_ENABLED=false
# Payment runtime remains disabled. These are names/defaults, not credentials.
# Existing secrets TRANZILA_API_APP_KEY and TRANZILA_API_SECRET were bound at
# version 1 in the completed private diagnostic; never copy their values here.
TRANZILA_ENABLED=false
TRANZILA_MERCHANT_CONFIGURATION_VERIFIED=false
TRANZILA_REPORT_CONTRACT_VERIFIED=false
TRANZILA_ORDER_LOOKUP_VERIFIED=false
PAYMENT_RECONCILIATION_ENABLED=false
TRANZILA_TERMINAL=fxpmyry
TRANZILA_CHECKOUT_URL=
TRANZILA_ORDER_PARAMETER=chilik_order_id
# Authenticated field metadata verified slot 10 on fxpmyry at 2026-10-06 17:21 UTC.
# This mapping does not verify transaction echo, capture, lookup or cancellation.
TRANZILA_ORDER_REPORT_FIELD=user_defined_10
TRANZILA_ORDER_FILTER_PARAMETER=
TRANZILA_CHECKOUT_TRANMODE=
TRANZILA_CAPTURE_PAIRS_JSON=
PAYMENT_SITE_ORIGIN=https://www.chilik-tours.com
PAYMENT_API_BASE=https://us-central1-hilik-site.cloudfunctions.net
# GCLOUD_PROJECT/GCP_PROJECT comes from the runtime, not a merchant default here.
# See docs/PAYMENT_RUNTIME.md. Email, Calendar and WhatsApp remain disabled.

# Approved provider is Twilio, not a direct Meta Cloud API configuration.
# Secrets are securely provisioned later, never pasted here.
# API-key mode binds CHILIK_TWILIO_API_KEY_SECRET; auth-token mode binds
# CHILIK_TWILIO_AUTH_TOKEN. Select one approved mode explicitly; no fallback.
CHILIK_WHATSAPP_PROVIDER=twilio
CHILIK_WHATSAPP_ENABLED=false
CHILIK_WHATSAPP_CONFIGURATION_VERIFIED=false
CHILIK_WHATSAPP_RECIPIENT_OPT_IN_VERIFIED=false
CHILIK_TWILIO_ACCOUNT_SID=
CHILIK_TWILIO_SENDER_SID=XEf2b30f702857e60e8dab2bc74b3a53d4
CHILIK_TWILIO_AUTH_MODE=api-key
CHILIK_TWILIO_API_KEY_SID=
CHILIK_TWILIO_CONTENT_SID=
CHILIK_TWILIO_TEMPLATE_NAME=
CHILIK_WHATSAPP_TEMPLATE_LANGUAGE=he
