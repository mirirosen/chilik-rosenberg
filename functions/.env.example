# Tranzila card-payment configuration (functions).
# Copy to functions/.env for local emulation ONLY. Never commit real values.
# Secrets (TRANZILA_PW) belong in Secret Manager, not in this file.

# Tranzila terminal name (supplier) — non-secret, appears in the payment URL.
# Example: TRANZILA_TERMINAL=chilik-tours
TRANZILA_TERMINAL=

# Set to "true" only if the terminal requires the password in the payment request.
TRANZILA_REQUIRE_PW=false

# tranmode for the Tranzila payment page. Confirm against terminal config.
TRANZILA_TRANMODE=AK

# Public site URL — used to build success/failure redirect URLs.
PUBLIC_SITE_URL=https://www.chilik-tours.com

# Frontend build-time: base URL of the deployed functions (no trailing slash).
# Example: VITE_PAYMENT_API_BASE=https://europe-west1-PROJECT.cloudfunctions.net
VITE_PAYMENT_API_BASE=
